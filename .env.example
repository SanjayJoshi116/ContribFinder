# Copy to .env and fill in. Never commit .env.

# --- Django ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=config.settings.development
# Development settings only (default true); production always runs without debug.
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Seconds a session lasts (14 days).
# SESSION_COOKIE_AGE=1209600
# DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO

# --- Data stores ----------------------------------------------------------
# Local (`npm start`): the locally installed PostgreSQL. docker-compose overrides both
# values with container hostnames, so this file works for either mode.
DATABASE_URL=postgres://contribfinder:contribfinder@localhost:5432/contribfinder
# Seconds a database connection is reused (0 = a new one per request).
# DB_CONN_MAX_AGE=60
# Local on Windows: Redis inside WSL Ubuntu (`npm start` starts it and a Celery worker).
# db 1 keeps ContribFinder apart from anything else in that Redis.
# Leave empty to run without Redis: in-process cache and tasks run inline (syncs block).
# Required in production.
REDIS_URL=redis://localhost:6379/1
# Seconds before a Redis call gives up (cache and broker connect).
# REDIS_SOCKET_TIMEOUT=5
# After a Redis error, API throttling counts in process memory and skips Redis this long.
# THROTTLE_CACHE_BACKOFF_SECONDS=30
# After a Redis error, GitHub requests skip the response cache (no ETag) this long.
# GITHUB_CACHE_BACKOFF_SECONDS=30
# GitHub response bodies larger than this (bytes) are not cached (Redis also holds the broker).
# GITHUB_ETAG_MAX_BYTES=262144
# A RUNNING job with no heartbeat this long counts as dead; beat requeues it.
# SYNC_STALE_AFTER_SECONDS=600
# JOB_RECOVERY_INTERVAL_SECONDS=300
# Celery worker threads on Windows (`npm start`).
# CELERY_CONCURRENCY=4

# --- GitHub OAuth App -----------------------------------------------------
# Register at https://github.com/settings/developers
# Callback URL (dev): http://localhost:5173/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Space- or comma-separated. Empty = public data only (recommended).
GITHUB_OAUTH_SCOPES=
# Default: FRONTEND_URL + /api/v1/auth/github/callback. Must match the OAuth App's callback URL.
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/api/v1/auth/github/callback
# Pending sign-ins per session (one per tab) and how long each stays valid (seconds).
# OAUTH_STATE_MAX_PENDING=5
# OAUTH_STATE_TTL_SECONDS=600

# --- GitHub sync (optional; defaults shown) ----------------------------------
# Seconds before a GitHub request gives up.
# GITHUB_HTTP_TIMEOUT=10.0
# Repositories synced per user, and pages read from any paginated GitHub list.
# GITHUB_SYNC_MAX_REPOS=100
# GITHUB_MAX_PAGES=10
# Longest wait (seconds) honored from a GitHub rate limit before a retry.
# GITHUB_MAX_RETRY_DELAY=900
# Seconds a cached GitHub response (ETag) is kept.
# GITHUB_ETAG_TTL=86400
# Attempts per sync job, and seconds between syncs a user may start.
# SYNC_MAX_ATTEMPTS=5
# SYNC_COOLDOWN_SECONDS=300

# --- API throttling (optional; defaults shown) -------------------------------
# THROTTLE_ANON=60/min
# THROTTLE_USER=300/min
# Sign-in endpoints.
# THROTTLE_AUTH=10/min

# --- Token encryption -----------------------------------------------------
# Comma-separated Fernet keys, newest first. Old keys stay decrypt-only for rotation.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing all keys makes stored GitHub tokens unreadable; users simply sign in again.
TOKEN_ENCRYPTION_KEYS=

# --- Frontend / origins ---------------------------------------------------
# Public URL of the SPA; post-login redirects go here.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Proxies in front of Django that append to X-Forwarded-For. 1 = the Vite dev proxy (local) or
# one load balancer (production). 0 trusts no forwarded header (throttling, audit IP, HTTPS
# detection all use the connecting address). Count only proxies you control.
NUM_PROXIES=1

# --- Production only (defaults shown) ---------------------------------------
# Redirect plain HTTP to HTTPS (health checks are exempt).
# SECURE_SSL_REDIRECT=true
# HSTS max-age; includeSubDomains and preload affect every host on the domain, so they are opt-in.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false

# --- Developer profile (optional; defaults shown) ---------------------------
# Evidence weights (0-1) per source; a JSON object overrides individual sources.
# EVIDENCE_WEIGHTS={"readme": 0.2, "topic": 0.3, "language": 0.5, "dependency": 0.6, "commit": 0.8, "pull_request": 0.9, "repeated_contribution": 1.0}
# EVIDENCE_REPEAT_DECAY=0.5
# CONFIDENCE_CAP=0.99
# LANGUAGE_MIN_SHARE=0.10
# REPEATED_CONTRIBUTION_MIN_PRS=3
# INTEREST_EVIDENCE_WEIGHTS={"readme": 0.3, "repo_description": 0.4, "topic": 0.5, "contribution": 0.6}
# INTEREST_MIN_STRENGTH=0.35
# Per signal: [intermediate_from, experienced_from]; a JSON object overrides individual signals.
# EXPERIENCE_THRESHOLDS={"account_age_years": [1, 4], "active_repositories": [3, 10], "merged_external_prs": [1, 15], "contributed_repositories": [1, 4], "well_evidenced_skills": [3, 8]}
# Per-sync GitHub budget for dependency manifests and external contributions.
# GITHUB_MANIFEST_MAX_REPOS=30
# GITHUB_MANIFEST_MAX_BYTES=524288
# GITHUB_CONTRIB_MAX_PRS=200
# GITHUB_CONTRIB_MAX_REPOS=20
# After changing weights or the skill catalog: python manage.py reanalyze_profiles

# --- Repository discovery (optional; defaults shown) -------------------------
# Search requests per discovery run (one query in one star band) and how they are split
# across strategies. Must be at least the number of star bands.
# DISCOVERY_MAX_QUERIES=20
# DISCOVERY_QUERY_SHARES={"language": 2, "skill": 4, "interest": 3, "topic": 1}
# DISCOVERY_RESULTS_PER_QUERY=30
# Hard filters added to every search query.
# DISCOVERY_MIN_STARS=20
# Each query runs once per star band ([low, high], null = no upper bound), so smaller projects
# are found too. Ascending, non-overlapping; the first starts at DISCOVERY_MIN_STARS. Unset, the
# bands follow DISCOVERY_MIN_STARS (MIN..999 and 1000+). DISCOVERY_MAX_QUERIES should be a
# multiple of the band count (warning core.W003 otherwise).
# [[20, null]] restores the single-query behavior (with DISCOVERY_MAX_QUERIES=10).
# DISCOVERY_STAR_BANDS=[[20, 999], [1000, null]]
# Topics that mark a suspected curated list or documentation repository. A suspected list (also
# a repository named awesome / awesome-*) is not_code once its analysis finds no manifest
# dependencies; a repository without a detected language is always not_code.
# DISCOVERY_EXCLUDED_TOPICS=["awesome", "awesome-list", "awesome-lists", "curated-list", "list", "lists", "books", "free-books", "interview-questions", "cheatsheet", "cheatsheets"]
# DISCOVERY_MAX_PUSH_AGE_DAYS=180
# DISCOVERY_MIN_SKILL_CONFIDENCE=0.3
# DISCOVERY_MAX_ANALYSES_PER_RUN=60
# Repositories analyzed at once per run (1 = sequential). Keep low: GitHub secondary limits.
# DISCOVERY_ANALYSIS_CONCURRENCY=4
# DISCOVERY_MAX_POOL=300
# DISCOVERY_CANDIDATE_RETENTION_DAYS=30
# Candidate repository data. Background refresh (Celery beat) uses the OAuth app's client
# credentials above, never a user's token.
# REPO_README_MAX_BYTES=204800
# REPO_SNAPSHOT_HISTORY=10
# REPO_STALE_AFTER={"issues": 6, "metadata": 12, "activity": 24, "community": 168, "dependencies": 168, "readme": 168}
# REPO_REFRESH_BATCH=50
# REPO_DISCOVERED_GRACE_MINUTES=10
# REPO_FAILED_RETRY_HOURS=24
# REPO_REFRESH_RETRY_MINUTES=60
# ACTIVITY_THRESHOLDS={"recent_push_days": 30, "recent_commits": 10, "recent_merged_prs": 5, "moderate_push_days": 90, "moderate_commits": 1, "moderate_merged_prs": 1}

# --- Recommendations (optional; defaults shown) -----------------------------
# Signal weights and match bands are versioned ScoringConfig rows (Django admin), not env vars.
# RECOMMENDATIONS_TOP_N=50
# RECOMMENDATION_MIN_SCORE=0.1
# REPO_SIZE_THRESHOLDS={"small": 10, "medium": 100}
# RECOMMENDATION_REFRESH_INTERVAL_SECONDS=1800
# Minutes the freshness sweep waits after a failed generation before trying again.
# RECOMMENDATION_FAILED_RETRY_MINUTES=360
# RECOMMENDATION_README_EXCERPT_CHARS=1500

# --- Feedback (optional; defaults shown) -------------------------------------
# FEEDBACK_VIEW_DEDUP_MINUTES=30

# --- Issues (optional; defaults shown) ---------------------------------------
# Pages of 100 most recently updated open issues fetched per repository.
# ISSUES_MAX_PAGES=1
# Also fetched: one page of open issues per entry label (comma-separated; empty for none).
# ISSUES_ENTRY_LABELS=good first issue,help wanted
# ISSUE_BODY_MAX_CHARS=10000
# Issues not updated for this many days are never recommended.
# ISSUE_MAX_AGE_DAYS=365
# Difficulty estimate thresholds (characters, technologies, comments, agreeing votes).
# min_votes 2..4; above 2 no issue can be estimated intermediate (startup warning core.W004).
# ISSUE_DIFFICULTY={"short_body": 600, "long_body": 4000, "several_technologies": 2, "many_technologies": 3, "long_discussion": 15, "min_votes": 2}
