# Copy to .env and fill in. Never commit .env.

# --- Django ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Data stores ----------------------------------------------------------
# Local (`npm start`): the locally installed PostgreSQL. docker-compose overrides both
# values with container hostnames, so this file works for either mode.
DATABASE_URL=postgres://contribfinder:contribfinder@localhost:5432/contribfinder
# Local on Windows: Redis inside WSL Ubuntu (`npm start` starts it and a Celery worker).
# db 1 keeps ContribFinder apart from anything else in that Redis.
# Leave empty to run without Redis: in-process cache and tasks run inline (syncs block).
# Required in production.
REDIS_URL=redis://localhost:6379/1

# --- GitHub OAuth App -----------------------------------------------------
# Register at https://github.com/settings/developers
# Callback URL (dev): http://localhost:5173/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Space-separated. Empty = public data only (recommended).
GITHUB_OAUTH_SCOPES=

# --- Token encryption -----------------------------------------------------
# Comma-separated Fernet keys, newest first. Old keys stay decrypt-only for rotation.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing all keys makes stored GitHub tokens unreadable; users simply sign in again.
TOKEN_ENCRYPTION_KEYS=

# --- Frontend / origins ---------------------------------------------------
# Public URL of the SPA; post-login redirects go here.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Developer profile (optional; defaults shown) ---------------------------
# Evidence weights (0-1) per source; a JSON object overrides individual sources.
# EVIDENCE_WEIGHTS={"readme": 0.2, "topic": 0.3, "language": 0.5, "dependency": 0.6, "commit": 0.8, "pull_request": 0.9, "repeated_contribution": 1.0}
# EVIDENCE_REPEAT_DECAY=0.5
# CONFIDENCE_CAP=0.99
# LANGUAGE_MIN_SHARE=0.10
# REPEATED_CONTRIBUTION_MIN_PRS=3
# INTEREST_EVIDENCE_WEIGHTS={"readme": 0.3, "repo_description": 0.4, "topic": 0.5, "contribution": 0.6}
# INTEREST_MIN_STRENGTH=0.35
# Per-sync GitHub budget for dependency manifests and external contributions.
# GITHUB_MANIFEST_MAX_REPOS=30
# GITHUB_MANIFEST_MAX_BYTES=524288
# GITHUB_CONTRIB_MAX_PRS=200
# GITHUB_CONTRIB_MAX_REPOS=20
# After changing weights or the skill catalog: python manage.py reanalyze_profiles
