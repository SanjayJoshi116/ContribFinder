{
  "name": "contribfinder",
  "version": "0.12.50",
  "private": true,
  "description": "ContribFinder monorepo: local dev runner (Docker alternative: docker compose up)",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "start:backend": "node scripts/backend.mjs",
    "start:frontend": "node scripts/frontend.mjs",
    "check:version": "node scripts/check-version.mjs",
    "audit:deps": "node scripts/audit.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "lint:scripts": "eslint scripts",
    "format:scripts": "prettier --check scripts",
    "start:redis": "node scripts/redis.mjs",
    "start:worker": "node scripts/worker.mjs",
    "start:beat": "node scripts/beat.mjs",
    "stop": "node scripts/stop.mjs",
    "manage": "node scripts/manage.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
