            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": ""
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/api/v1/profile/github": {
      "get": {
        "operationId": "profile_github",
        "description": "Stored data only: never calls GitHub.",
        "tags": ["profile"],
        "security": [
          {
