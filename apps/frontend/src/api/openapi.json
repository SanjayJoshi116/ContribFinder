  },
  "components": {
    "schemas": {
      "ActivityLabelEnum": {
        "enum": ["recently_active", "moderately_active", "low_activity"],
        "type": "string",
        "description": "* `recently_active` - Recently Active\n* `moderately_active` - Moderately Active\n* `low_activity` - Low Activity"
      },
      "CandidateDiscovery": {
        "type": "object",
        "properties": {
          "source": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CandidateDiscoverySourceEnum"
              }
            ],
            "readOnly": true
          },
          "query": {
            "type": "string",
            "readOnly": true
          },
          "search_rank": {
            "type": "integer",
            "readOnly": true,
            "nullable": true
          },
          "first_seen_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "last_seen_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": ["first_seen_at", "last_seen_at", "query", "search_rank", "source"]
      },
      "CandidateDiscoverySourceEnum": {
        "enum": [
          "language_search",
          "topic_search",
          "skill_search",
          "interest_search",
          "similar_repo",
          "previously_interacted"
        ],
        "type": "string",
        "description": "* `language_search` - Language Search\n* `topic_search` - Topic Search\n* `skill_search` - Skill Search\n* `interest_search` - Interest Search\n* `similar_repo` - Similar Repo\n* `previously_interacted` - Previously Interacted"
      },
      "CandidateRepository": {
        "type": "object",
        "properties": {
          "full_name": {
            "type": "string",
            "readOnly": true
          },
          "owner": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "readOnly": true
          },
          "description": {
            "type": "string",
            "readOnly": true
          },
          "html_url": {
            "type": "string",
            "format": "uri",
            "readOnly": true
          },
          "primary_language": {
            "type": "string",
            "readOnly": true
          },
          "stars": {
            "type": "integer",
            "readOnly": true
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "readOnly": true
          },
          "license": {
            "type": "string"
          }
        },
        "required": [
          "description",
          "full_name",
          "html_url",
          "license",
          "name",
          "owner",
          "primary_language",
          "stars",
          "topics"
        ]
      },
      "CategoryEnum": {
        "enum": ["language", "framework", "library", "database", "cloud", "devops", "tool"],
        "type": "string",
        "description": "* `language` - Language\n* `framework` - Framework\n* `library` - Library\n* `database` - Database\n* `cloud` - Cloud\n* `devops` - Devops\n* `tool` - Tool"
      },
      "DeveloperInterest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "interest": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Interest"
              }
            ],
            "readOnly": true
          },
          "strength": {
            "type": "number",
            "format": "double",
            "readOnly": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InterestEvidence"
            },
            "readOnly": true
          }
        },
        "required": ["evidence", "id", "interest", "strength"]
      },
      "DeveloperProfile": {
        "type": "object",
        "description": "The analyzed profile. The experience level is an internal matching signal and is\ndeliberately not part of this representation (SRS-2 §17).",
        "properties": {
          "summary": {
            "type": "string",
            "readOnly": true
          },
          "languages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProfileLanguage"
            },
            "readOnly": true
          },
          "preferred_project_size": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PreferredProjectSizeEnum"
              }
            ],
            "readOnly": true
          },
          "preferred_issue_difficulty": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PreferredIssueDifficultyEnum"
              }
            ],
            "readOnly": true
          },
          "analyzed_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "skill_count": {
            "type": "integer",
            "readOnly": true
          },
          "interest_count": {
            "type": "integer",
            "readOnly": true
          }
        },
        "required": [
          "analyzed_at",
          "interest_count",
          "languages",
          "preferred_issue_difficulty",
          "preferred_project_size",
          "skill_count",
          "summary"
        ]
      },
      "DeveloperSkill": {
        "type": "object",
        "description": "``confidence`` (0-1) drives ranking and bar width; the UI never prints it.",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "skill": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Skill"
              }
            ],
            "readOnly": true
          },
          "confidence": {
            "type": "number",
            "format": "double",
            "readOnly": true
          },
          "evidence_summary": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EvidenceSummary"
              }
            ],
            "readOnly": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SkillEvidence"
            },
            "readOnly": true
          }
        },
        "required": ["confidence", "evidence", "evidence_summary", "id", "skill"]
      },
      "DisconnectResult": {
        "type": "object",
        "properties": {
          "revocation": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RevocationEnum"
              }
            ],
            "description": "Whether GitHub confirmed revocation. Local credentials are deleted either way.\n\n* `revoked` - revoked\n* `failed` - failed\n* `not_connected` - not_connected"
          }
        },
        "required": ["revocation"]
      },
      "DiscoveryStatus": {
        "type": "object",
        "properties": {
          "job": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SyncJob"
              }
            ],
            "nullable": true
          },
          "last_completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "pool": {
            "$ref": "#/components/schemas/PoolCounts"
          }
        },
        "required": ["job", "last_completed_at", "pool"]
      },
      "Error": {
        "type": "object",
        "description": "Standard error envelope, referenced by every endpoint's error responses.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": ["error"]
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {}
        },
        "required": ["code", "message"]
      },
      "EvidenceRepository": {
        "type": "object",
        "properties": {
          "full_name": {
            "type": "string",
            "readOnly": true
          },
          "html_url": {
            "type": "string",
            "format": "uri",
            "readOnly": true
          }
        },
        "required": ["full_name", "html_url"]
      },
      "EvidenceSummary": {
        "type": "object",
        "description": "Counts computed from the (prefetched) evidence of one skill.",
        "properties": {
          "by_source": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "repository_count": {
            "type": "integer"
          },
          "last_observed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": ["by_source", "last_observed_at", "repository_count"]
      },
      "GitHubProfile": {
        "type": "object",
