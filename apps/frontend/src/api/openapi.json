    "/api/v1/sync/status": {
      "get": {
        "operationId": "sync_status",
        "tags": ["sync"],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncStatus"
                }
              }
