              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "auth_me",
        "tags": ["auth"],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/api/v1/discovery/candidates": {
      "get": {
        "operationId": "discovery_candidates",
        "description": "The developer's candidate pool: analysed-eligible first, then awaiting analysis, then\nineligible; within each, the discovery job's analysis order (previously interacted, best\nsearch rank, name). Not a ranking.",
        "parameters": [
          {
            "in": "query",
            "name": "activity",
            "schema": {
              "type": "string",
              "enum": ["low_activity", "moderately_active", "recently_active"]
            },
            "description": "* `recently_active` - Recently Active\n* `moderately_active` - Moderately Active\n* `low_activity` - Low Activity"
          },
          {
            "in": "query",
            "name": "eligible",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "A page number within the paginated result set.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page_size",
            "required": false,
            "in": "query",
            "description": "Number of results to return per page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "source",
            "schema": {
              "type": "string",
              "enum": [
                "interest_search",
                "language_search",
                "previously_interacted",
                "similar_repo",
                "skill_search",
                "topic_search"
              ]
            },
            "description": "* `language_search` - Language Search\n* `topic_search` - Topic Search\n* `skill_search` - Skill Search\n* `interest_search` - Interest Search\n* `similar_repo` - Similar Repo\n* `previously_interacted` - Previously Interacted"
          }
        ],
        "tags": ["discovery"],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedRepositoryCandidateList"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/api/v1/discovery/status": {
      "get": {
        "operationId": "discovery_status",
        "tags": ["discovery"],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryStatus"
