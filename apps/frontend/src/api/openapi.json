{
  "openapi": "3.0.3",
  "info": {
    "title": "ContribFinder API",
    "version": "1.0.0",
    "description": "Developer-to-contribution-opportunity matching API."
  },
  "paths": {
    "/api/v1/auth/csrf/": {
